---
source: crates/ndc-pinot-core/tests/query_builder.rs
expression: pretty_print_sql(&rows.to_string())
input_file: crates/ndc-pinot-core/tests/query_builder/basic/03_predicate_neq.request.json
---
SET
  enableNullHandling = true;
SELECT
  "orderId" AS "orderId",
  "status" AS "status"
FROM
  "orders"
WHERE
  "status" != 'CANCELLED'
