---
source: crates/ndc-pinot-core/tests/query_builder.rs
expression: pretty_print_sql(&rows.to_string())
input_file: crates/ndc-pinot-core/tests/query_builder/basic/13_order_by_multiple.request.json
---
SET
  enableNullHandling = true;
SELECT
  "orderId" AS "orderId",
  "status" AS "status",
  "total" AS "total"
FROM
  "orders"
ORDER BY
  "status" ASC,
  "total" DESC
